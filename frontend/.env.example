# Copy to .env.local (untracked) for local development, or set as repository variables in CI.
# All are optional — the app falls back to same-origin paths and hides the contact line.

# Where the site reads editions and posts feedback. Same-origin behind CloudFront in production.
# VITE_DATA_BASE=/data
# VITE_API_BASE=/api

# Shown on the Terms & Disclaimer page as "For more information, see ...", and behind the
# person icon in the masthead. Omit to hide both.
# VITE_SITE_OWNER_URL=https://example.com

# Behind the GitHub icon in the masthead. Omit to hide the icon.
# VITE_REPO_URL=https://github.com/example/example
