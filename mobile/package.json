{
  "name": "daily-compile-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Capacitor iOS + Android shell for The Daily Compile. Bundles frontend/dist.",
  "scripts": {
    "build:web": "npm --prefix ../frontend run build",
    "sync": "cap sync",
    "sync:full": "npm run build:web && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "assets": "capacitor-assets generate"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/browser": "latest",
    "@capacitor/core": "latest",
    "@capacitor/ios": "latest",
    "@capacitor/splash-screen": "latest",
    "@capgo/capacitor-updater": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "latest",
    "@capacitor/cli": "latest"
  }
}
