{
  "name": "daily-compile-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Capacitor iOS + Android shell for The Daily Compile. Bundles frontend/dist.",
  "scripts": {
    "build:web": "npm --prefix ../frontend run build",
    "sync": "cap sync",
    "sync:full": "npm run build:web && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "assets": "capacitor-assets generate"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-updater": "^8.51.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0"
  }
}
