# Dependencies
node_modules/

# Generated native projects — scaffolded locally by `npx cap add android` / `add ios` from the web
# build and fully regenerable, so they are not committed. (If a store-build pipeline is set up later,
# commit android/ and ios/ and restore the granular build-artifact ignores; see mobile/README.md.)
android/
ios/

# Signing material — never in the repo, regardless of the above
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
AuthKey_*.p8
