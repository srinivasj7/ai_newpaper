# Copy to .env (git-ignored) on the pipeline host. Every variable the run reads is listed here.

# ---------------------------------------------------------------- AWS (required)
# Credentials for the dedicated pipeline IAM user created by infra/modules/ci.
# Scoped to the data prefix of one bucket plus one CloudFront invalidation, nothing else.
#   aws iam create-access-key --user-name daily-compile-pipeline
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# From `tofu output` in infra/envs/prod.
DATA_BUCKET=
DATA_PREFIX=data/
CLOUDFRONT_DISTRIBUTION_ID=

# ---------------------------------------------------------------- writers
# Claude Code runs headless. Interactive credentials expire in hours, so an unattended host
# needs a long-lived token instead — run `claude setup-token` once, anywhere with a browser,
# and paste the result here. Without it, a scheduled run will fail the moment the session
# token lapses.
CLAUDE_CODE_OAUTH_TOKEN=

# Only if a hosted provider is enabled in config/providers.yml.
# BEDROCK_API_KEY=
# XAI_API_KEY=

# ---------------------------------------------------------------- judge
# Where the judge is served. Under docker compose this is the ollama service; on a host
# running Ollama directly it is http://localhost:11434/v1.
OLLAMA_BASE_URL=http://ollama:11434/v1

# ---------------------------------------------------------------- tuning
# The paper's own calendar. The container runs on UTC, so without this an edition generated
# after 17:00 Pacific is dated tomorrow. Keep it equal to the scheduler's timezone; the ECS
# task definition sets it from exactly that value.
# EDITION_TZ=America/Los_Angeles
# LOG_LEVEL=INFO
# LOOKBACK_HOURS=36        # how far back a headline may be to still count as news
# MAX_HEADLINES=90         # pool size handed to the writers
# DRY_RUN=false            # do everything except write to S3
